# Server-side Gemini API key. Set as a Vercel Environment Variable (never in the browser).
# Without it, generation falls back to Thai templates and the assistant replies offline.
GEMINI_API_KEY=

# Server-side Gemini model override (optional). Defaults to gemini-3.1-flash-lite.
# Use a model available to your API key, e.g. gemini-2.0-flash or gemini-3.1-flash-lite.
GEMINI_MODEL=